{
  "name": "agentic-todo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:agent": "cd projects/agent-server && uv run uvicorn main:app --reload --port 4111",
    "dev:all": "npx concurrently \"npm start\" \"npm run dev:agent\"",
    "lab:01": "tsx --env-file=.env labs/lab-01-tool-call/exercise.ts",
    "lab:01:solution": "tsx --env-file=.env labs/lab-01-tool-call/solution.ts",
    "lab:02": "tsx --env-file=.env labs/lab-02-tool-conflict/exercise.ts",
    "lab:02:solution": "tsx --env-file=.env labs/lab-02-tool-conflict/solution.ts",
    "lab:03": "tsx --env-file=.env labs/lab-03-agui-events/exercise.ts",
    "lab:03:solution": "tsx --env-file=.env labs/lab-03-agui-events/solution.ts"
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@ag-ui/client": "0.0.47",
    "@angular/animations": "^21.2.3",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "marked": "^17.0.4",
    "openai": "^4.80.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^22.0.0",
    "axe-core": "^4.11.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
